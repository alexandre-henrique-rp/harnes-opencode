    "expectedEffects[].mustExist": "boolean — se true, falha se entidade não existir após trigger",
    "expectedEffects[].verify.method": "GET|POST",
    "expectedEffects[].verify.path": "endpoint para verificar o efeito",
    "expectedEffects[].verify.expectedStatus": "status HTTP esperado na verificação",
    "expectedEffects[].fieldAssertions[]": "validações por campo no response da verificação",
    "expectedEffects[].fieldAssertions[].field": "caminho JSON (suporta items[0].valor)",
    "expectedEffects[].fieldAssertions[].rule": "equals | match | contains | not-empty | in-range",
    "expectedEffects[].fieldAssertions[].value": "valor literal",
    "expectedEffects[].fieldAssertions[].source": "caminho para valor dinâmico (ex: tabela_precos[procedimento])",
    "expectedEffects[].fieldAssertions[].description": "string, o que garante",
    "criticality": "critical (bloqueia) | advisory (registra)",
    "blockedIfFails": "boolean — se true, falhar nesta regra = blocker"
  },
  "cleanup": {
    "description": "Limpar dados de teste criados",
    "steps": [
      { "method": "DELETE", "path": "/api/test/reset", "description": "Reset do banco de teste" }
    ]
  },
