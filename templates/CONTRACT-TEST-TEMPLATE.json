{
  "_type": "harness-contract-test-v6",
  "_description": "Template para testes de contrato que validam regras de negócio derivadas dos Acceptance Criteria da SPEC.md. Combina (1) contracts[] clássicos validando response primário + (2) businessRules[] validando side-effects cross-entity. Cada regra de negócio crítica DEVE ter um businessRules[] entry — só validar status 200 sem validar side-effects é bug silencioso.",
  "sprintId": "S01",
  "specRef": "US-001",
  "feature": "user-registration",
  "baseUrl": "http://localhost:3000",
  "setup": {
    "description": "Estado inicial necessário antes de rodar os testes",
    "fixtures": [
      {
        "entity": "user",
        "data": { "email": "existing@test.com", "cpf": "123.456.789-00", "name": "Existing User" },
        "via": "POST /api/users"
      }
    ],
    "env": {
      "DATABASE_URL": "postgresql://test:test@localhost:5432/test_db"
    }
  },
  "contracts": [
    {
      "id": "CT-001",
      "acceptanceCriteria": "AC-001: Cadastro com dados válidos retorna 201 e cria o usuário",
      "specRef": "US-001.AC-001",
      "type": "happy-path",
      "request": {
        "method": "POST",
        "path": "/api/users",
        "headers": { "Content-Type": "application/json" },
        "body": {
          "email": "new@test.com",
          "cpf": "987.654.321-00",
          "name": "New User",
          "password": "Str0ng!Pass"
        }
      },
      "expectedResponse": {
        "status": 201,
        "bodySchema": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "equals": "new@test.com" },
          "name": { "type": "string", "equals": "New User" },
          "createdAt": { "type": "string", "format": "iso8601" }
        },
        "bodyMustNotContain": ["password", "cpf"],
        "headers": {
          "content-type": "application/json"
        }
      },
      "sideEffects": [
        {
          "description": "Usuário existe no banco após criação",
          "verify": {
            "method": "GET",
            "path": "/api/users/{response.id}",
            "expectedStatus": 200,
            "expectedBody": { "email": "new@test.com" }
          }
        }
      ]
    },
    {
      "id": "CT-002",
      "acceptanceCriteria": "AC-002: Email duplicado retorna 422 com campo e mensagem específicos",
      "specRef": "US-001.AC-002",
      "type": "business-rule",
      "request": {
        "method": "POST",
        "path": "/api/users",
        "headers": { "Content-Type": "application/json" },
        "body": {
          "email": "existing@test.com",
          "cpf": "111.222.333-44",
          "name": "Duplicate Email User",
          "password": "Str0ng!Pass"
        }
      },
      "expectedResponse": {
        "status": 422,
        "bodySchema": {
          "errors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "field": { "type": "string", "equals": "email" },
              "rule": { "type": "string", "equals": "unique" },
              "message": { "type": "string", "contains": "já cadastrado" }
            }
          }
        }
      },
      "sideEffects": [
        {
          "description": "Nenhum usuário novo foi criado",
          "verify": {
            "method": "GET",
            "path": "/api/users?email=existing@test.com",
            "expectedStatus": 200,
            "expectedBody": { "total": 1 }
          }
        }
      ]
    },
    {
      "id": "CT-003",
      "acceptanceCriteria": "AC-003: CPF inválido retorna 422 com validação específica",
      "specRef": "US-001.AC-003",
      "type": "validation",
      "request": {
        "method": "POST",
        "path": "/api/users",
        "headers": { "Content-Type": "application/json" },
        "body": {
          "email": "valid@test.com",
          "cpf": "000.000.000-00",
          "name": "Invalid CPF User",
          "password": "Str0ng!Pass"
        }
      },
      "expectedResponse": {
        "status": 422,
        "bodySchema": {
          "errors": {
            "type": "array",
            "items": {
              "field": { "type": "string", "equals": "cpf" },
              "rule": { "type": "string", "equals": "invalid" },
              "message": { "type": "string", "contains": "CPF inválido" }
            }
          }
        }
      }
    },
    {
      "id": "CT-004",
      "acceptanceCriteria": "AC-004: Campos obrigatórios ausentes retorna 422 listando todos os campos faltantes",
      "specRef": "US-001.AC-004",
      "type": "validation",
      "request": {
        "method": "POST",
        "path": "/api/users",
        "headers": { "Content-Type": "application/json" },
        "body": {}
      },
      "expectedResponse": {
        "status": 422,
        "bodySchema": {
          "errors": {
            "type": "array",
            "minItems": 4,
            "eachFieldPresent": ["email", "cpf", "name", "password"]
          }
        }
      }
    },
    {
      "id": "CT-005",
      "acceptanceCriteria": "AC-005: Request sem autenticação em endpoint protegido retorna 401",
      "specRef": "US-001.AC-005",
      "type": "auth",
      "request": {
        "method": "GET",
        "path": "/api/users/me",
        "headers": {}
      },
      "expectedResponse": {
        "status": 401,
        "bodySchema": {
          "error": { "type": "string", "contains": "não autenticado" }
        }
      }
    }
  ],
  "businessRules": [
    {
      "_comment": "Exemplo: regra crítica que valida side-effect cross-entity. Esta seção é OBRIGATÓRIA quando a regra de negócio envolve criar/modificar entidades em cascata. Diferente do contracts[] clássico (que valida só o response primário), aqui validamos o efeito composto.",
      "ruleId": "BR-EXAMPLE-001",
      "description": "Cadastro de usuário com email duplicado NÃO cria duplicata (validação cross-entity)",
      "trigger": {
        "method": "POST",
        "path": "/api/users",
        "actor": "anonimo"
      },
      "linkedContracts": ["CT-002"],
      "expectedEffects": [
        {
          "entity": "user",
          "mustExist": false,
          "description": "Após tentativa com email duplicado, NÃO pode haver novo usuário criado",
          "verify": {
            "method": "GET",
            "path": "/api/users?email=existing@test.com",
            "expectedStatus": 200
          },
          "fieldAssertions": [
            {
              "field": "total",
              "rule": "equals",
              "value": 1,
              "description": "Total deve permanecer 1 (usuário original) — duplicata não foi criada"
            }
          ]
        }
      ],
      "criticality": "critical",
      "blockedIfFails": true,
      "notes": "Bug clássico: teste passa (status 422) mas backend cria o user ANTES de validar. Esta validação cross-entity detecta."
    }
  ],
  "_businessRulesSchema": {
    "_comment": "Schema de validação da seção businessRules[]",
    "ruleId": "string, kebab-case com prefixo BR-, bate com .harness/business-rules.json",
    "description": "string, frase clara da regra de negócio composta",
