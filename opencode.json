{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "formatter": true,
  "instructions": [
    ".opencode/CONSTITUTION.md"
  ],
  "permission": {
    "bash": {
      "*": "allow",
      "rm *training*": "ask",
      "rm -r *training*": "ask",
      "rm -rf *training*": "ask",
      "rm -f *training*": "ask",
      "rm -rfv *training*": "ask"
    },
    "edit": "allow",
    "read": "allow",
    "external_directory": {
      "~/.config/opencode/**": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "formatter": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
    "task": "allow",
    "skill": {
      "*": "allow"
    }
  },
  "mcp": {},
  "default_agent": "orchestrator"
}
