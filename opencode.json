{
  "$schema": "https://opencode.ai/config.json",
  "lsp":true,
  "formatter": true,
  "instructions": [
    "~/.config/opencode/GERAIS.md",
    "./system/objectivity.md"
  ],
  "plugin": [
    "./plugins/path-boundary.ts",
    "./plugins/audit-logger.ts",
    "./plugins/status-injector.ts",
    "./plugins/native-sandbox.ts",
    "./plugins/context-compressor.ts",
    "./plugins/prompt-cache-prefixer.ts",
    "./plugins/token-budget.ts",
    "./plugins/structured-thinking.ts"
  ],
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "formatter": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
    "task": "allow",
    "skill": {
      "*": "allow"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "node",
        "~/.config/opencode/node_modules/@playwright/mcp/cli.js"
      ]
    },
    "drawio": {
      "type": "local",
      "command": [
        "node",
        "~/.config/opencode/node_modules/@drawio/mcp/src/index.js"
      ]
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "node",
        "~/.config/opencode/node_modules/chrome-devtools-mcp/build/src/bin/chrome-devtools-mcp.js",
        "--autoConnect"
      ]
    },
    "pencil": {
      "command": [
        "~/.pencil/mcp/devin/out/mcp-server-linux-x64",
        "--app",
        "devin",
        "--agent",
        "openCodeCLI"
      ],
      "enabled": false,
      "type": "local"
    },
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "enabled": true,
      "headers": {
        "X-Goog-Api-Key": "${env:STITCH_API_KEY}"
      }
    },
    "duckduckgo-search": {
      "type": "local",
      "command": [
        "node",
        "~/.config/opencode/node_modules/duckduckgo-mcp-server/build/index.js"
      ]
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-55f0c677-1371-4a7a-99bf-040726afbb46"
      }
    }
  },
  "default_agent": "orchestrator",
  "experimental": {
    "frontendContextFirst": true,
    "_comment": "v6.5.0 — habilita novo fluxo frontend (context-first + grill-me). Set false para reverter para o legacy behavior."
  },
  "agent": {
    "orchestrator": {
      "tools": {
        "skill": true,
        "task": true
      },
      "permission": {
        "skill": {
          "*": "allow"
        }
      }
    }
  }
}
