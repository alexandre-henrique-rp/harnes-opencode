{
  "name": "opencode-harness",
  "version": "7.0.0",
  "description": "Spec-Anchored Multi-Agent Harness for OpenCode — installs and audits .opencode/ project workflows",
  "author": "Alexandre Henrique",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexandre-henrique-rp/harnes-opencode.git"
  },
  "keywords": [
    "opencode",
    "ai-agents",
    "spec-driven",
    "sdd",
    "harness",
    "multi-agent",
    "cli"
  ],
  "type": "module",
  "bin": {
    "opencode-harness": "./bin/opencode-harness.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "bin",
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "validate:types": "tsc --noEmit",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.ts",
    "validate": "npm run validate:types && npm test",
    "prepublishOnly": "npm run validate && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3"
  }
}
