# Harness v6 — Environment variables template
# Copie este arquivo para `~/.config/opencode/.env` ou `.env` na raiz do projeto.
# Estas variáveis são lidas pelo opencode runtime via ${env:VAR} no opencode.jsonc.

# ----------------------------------------------------------------------------
# MCPs remotos (opcionais)
# ----------------------------------------------------------------------------

# Google Stitch MCP — gera designs via Gemini (https://stitch.withgoogle.com/)
# Obtenha sua chave em https://stitch.withgoogle.com/settings
STITCH_API_KEY=

# Context7 MCP — docs atualizadas de libs (https://context7.com/)
# A chave padrão abaixo é compartilhada (rate-limited); pegue a sua em
# https://context7.com/dashboard para uso intenso.
CONTEXT7_API_KEY=ctx7sk-55f0c677-1371-4a7a-99bf-040726afbb46

# ----------------------------------------------------------------------------
# Sandbox ai-jail (opcional — deixe em branco para auto-detectar)
# ----------------------------------------------------------------------------

# Quando 1, indica que a sessão pai já está rodando dentro do ai-jail.
# Plugin native-sandbox.ts pula o re-wrap. Definida automaticamente quando
# você inicia opencode com: AI_JAIL_ACTIVE=1 ai-jail opencode
# AI_JAIL_ACTIVE=1

# Quando 1, desabilita completamente o sandbox por-comando (fallback gracioso).
# Use APENAS se ai-jail/bwrap está quebrado E você não pode rodar
# AI_JAIL_ACTIVE=1 ai-jail opencode. Sem sandbox, comandos bash rodam livres.
# HARNESS_NO_SANDBOX=0

# ----------------------------------------------------------------------------
# Modo do path-boundary (opcional — padrão fail-open)
# ----------------------------------------------------------------------------

# fail-open (padrão): paths fora do allowlist global são permitidos
# fail-closed: paths fora do allowlist são BLOQUEADOS (mais seguro, pode
# quebrar em ambientes não-preparados)
# HARNESS_PATH_BOUNDARY_MODE=fail-open

# Quando 1, o plugin path-boundary adiciona AUTOMATICAMENTE paths bloqueados
# ao .harness/harness-allowlist.json (allow) e permite a escrita. Reduz de
# 4 round-trips para 1: o usuario nao precisa aprovar manualmente.
# Hot-reload via mtime: NAO precisa reiniciar opencode apos edicao.
# Recomendado para desenvolvimento local; NAO recomendado em CI/producao.
# HARNESS_AUTO_ALLOW_ON_BLOCK=0

# Kill switch global para auto-allow (sobrescreve HARNESS_AUTO_ALLOW_ON_BLOCK).
# Quando 1, mesmo com auto-allow setado, NAO ha adicao automatica.
# Util em demos, gravacao de tela, ambientes compartilhados.
# HARNESS_NO_AUTO_ALLOW=0

# Cooldown em ms para auto-add do mesmo pattern (default: 60000 = 60s).
# Evita spam quando o mesmo path eh bloqueado repetidamente em loop.
# Defina 0 para desabilitar cooldown.
# HARNESS_AUTO_ALLOW_COOLDOWN_MS=60000

# Rate limit: maximo de auto-adds por minuto (sliding window, default: 10).
# Evita que um agente em loop infinito polua o allowlist.
# Defina 0 para desabilitar rate limit.
# HARNESS_AUTO_ALLOW_MAX_PER_MIN=10