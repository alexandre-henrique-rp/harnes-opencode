{
  "_about": "Lista de arquivos/diretorios essenciais para download/distribuicao. Sujeira (backup/, tmp/, .harness/audit/, .env*, etc.) NAO eh incluida. Usado por install.sh --list-essentials e --package.",
  "version": "1.0.0",
  "includeFolders": [
    "agents",
    "commands",
    "config",
    "docs",
    "plugins",
    "schemas",
    "skills",
    "system",
    "templates",
    "tools",
    "training",
    "examples"
  ],
  "includeFiles": [
    "AGENTS.md",
    "GERAIS.md",
    "HARNESS-README.md",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    ".ai-jail",
    "opencode.json",
    "opencode.jsonc",
    "package.json",
    "package-lock.json",
    "bun.lock",
    "tsconfig.json",
    "global.d.ts",
    "state-machine.json",
    "state-machine-lean.json",
    "failure-protocol.json",
    "skills-lock.json",
    "install.sh",
    "harness-allowlist.json",
    "DIST-MANIFEST.json"
  ],
  "excludePatterns": [
    "backup/**",
    "tmp/**",
    "node_modules/**",
    ".harness/**",
    ".harness/tmp/**",
    ".harness/audit/**",
    ".harness/sandbox-diagnostic.json",
    ".env",
    ".env.*",
    ".env.example",
    "tools/env.example",
    "*.log",
    "*.tar.gz",
    "*.zip",
    "*.tgz",
    ".DS_Store",
    ".idea/**",
    ".vscode/**",
    "dist/**",
    "build/**",
    "coverage/**",
    ".harness-manifest.json",
    ".harness-version"
  ],
  "notes": [
    "install.sh eh executavel no Linux/Mac. No Windows, use WSL ou Git Bash.",
    "skills/, training/ e templates/ podem ser grandes. Para reduzir, remova dos includeFolders antes de --package.",
    "examples/ eh opcional — pode ser removido para distribuicoes minimas."
  ]
}